# ── Application ──────────────────────────────────────────────
APP_NAME=The Herald
APP_ENV=development
DEBUG=False
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/v1
SECRET_KEY=change-this-in-production-herald-secret-key
API_KEY=herald-dev-api-key

# ── Database (PostgreSQL) ────────────────────────────────────
# Trust-auth: postgresql+asyncpg://<user>@localhost:5432/the_herald
# Password:   postgresql+asyncpg://<user>:<password>@localhost:5432/the_herald
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/the_herald

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Email delivery (Phase 8) ─────────────────────────────────
# EMAIL_PROVIDER: "resend" (real email, default) or "mock" (tests only)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=The Herald

# ── Retry / digest ───────────────────────────────────────────
DELIVERY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5
# Time limits live here so they can be tested in minutes: the digest window is 5 min by
# default; set e.g. 15000 (15 s) for demos/tests. Unset = workflow value.
# DIGEST_WINDOW_MS_OVERRIDE=15000

# ── AI smart digest (Phase 9) ────────────────────────────────
# AI_PROVIDER: "groq" (real LLM, default) or "mock" (tests only)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
